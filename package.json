{
  "name": "flit-boilerplate",
  "version": "1.0.0",
  "description": "FLIT Boilerplate — Full-stack monorepo con agentes IA integrados",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "concurrently -k \"pnpm run dev:api\" \"pnpm run dev:frontend:wait\"",
    "dev:frontend:wait": "wait-on -t 120000 http-get://localhost:3030/api/v1/health && pnpm --filter @flit/frontend dev",
    "dev:api": "dotnet watch run --project services/core-api/src/Flit.Api/Flit.Api.csproj",
    "dev:frontend": "pnpm --filter @flit/frontend dev",
    "build": "dotnet build services/core-api/Flit.slnx && pnpm --filter @flit/frontend build",
    "build:api": "dotnet build services/core-api/Flit.slnx",
    "test": "dotnet test services/core-api/Flit.slnx && pnpm --filter @flit/frontend test",
    "test:api": "dotnet test services/core-api/tests/Flit.Api.Tests/Flit.Api.Tests.csproj",
    "validate:ef-migrations": "bash scripts/validate-ef-migrations.sh",
    "validate:ef-migrations:win": "powershell -ExecutionPolicy Bypass -File scripts/validate-ef-migrations.ps1",
    "validate:pre-push": "bash scripts/validate-pre-push.sh",
    "validate:pre-push:win": "powershell -ExecutionPolicy Bypass -File scripts/validate-pre-push.ps1",
    "migrate": "dotnet ef database update --project services/core-api/src/Flit.Infrastructure/Flit.Infrastructure.csproj --startup-project services/core-api/src/Flit.Api/Flit.Api.csproj",
    "lint": "pnpm --filter @flit/frontend lint",
    "format:check": "pnpm --filter @flit/frontend format:check",
    "sync:agents": "./scripts/sync-agents.sh"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
