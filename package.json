{
  "name": "flit-boilerplate",
  "version": "1.0.0",
  "description": "FLIT Boilerplate — Full-stack monorepo con agentes IA integrados",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm --filter @flit/frontend dev\"",
    "dev:api": "dotnet watch run --project backend/dotnet/src/Flit.Api/Flit.Api.csproj",
    "dev:frontend": "pnpm --filter @flit/frontend dev",
    "build": "dotnet build backend/dotnet/Flit.slnx && pnpm --filter @flit/frontend build",
    "build:api": "dotnet build backend/dotnet/Flit.slnx",
    "test": "dotnet test backend/dotnet/src/Flit.Api/Flit.Api.csproj && pnpm --filter @flit/frontend test",
    "test:api": "dotnet test backend/dotnet/src/Flit.Api/Flit.Api.csproj",
    "migrate": "dotnet ef database update --project backend/dotnet/src/Flit.Infrastructure/Flit.Infrastructure.csproj --startup-project backend/dotnet/src/Flit.Api/Flit.Api.csproj",
    "lint": "pnpm --filter @flit/frontend lint",
    "format:check": "pnpm --filter @flit/frontend format:check",
    "sync:agents": "./scripts/sync-agents.sh"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
