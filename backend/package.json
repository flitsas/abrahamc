{
  "name": "@flit/backend",
  "version": "1.0.0",
  "description": "FLIT Backend — Node.js 22 + TypeScript + Fastify + TypeORM + PostgreSQL",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "migration:run": "tsx src/shared/config/run-migrations.ts",
    "migration:revert": "tsx src/shared/config/revert-migration.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^4.0.2",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.9.0",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.3.3",
    "tsx": "^4.17.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
