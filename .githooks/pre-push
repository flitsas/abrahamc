#!/usr/bin/env bash
# Bloquea push si falla validate-pre-push (Prettier + lint + typecheck + tests + build + backend + EF + gitleaks).
# Ver .cursor/rules/pre-push-gate.mdc — activar con: pnpm run hooks:install
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*)
    # Git Bash en Windows: usar script PowerShell (gitleaks/Docker paths correctos)
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT/scripts/validate-pre-push.ps1"
    ;;
  *)
    bash "$ROOT/scripts/validate-pre-push.sh"
    ;;
esac
