# Copia este archivo a `env` en la raíz del monorepo y rellena los valores reales (VPS/producción).
# Para desarrollo local, copia `env.local.example` → `env.local` (tiene prioridad sobre `env`).
# Ninguno de los dos se commitea (ver .gitignore).

# PostgreSQL (.NET connection string)
CONNECTION_STRING_CORE=Host=localhost;Port=5433;Database=flit_dev;Username=flit;Password=flit_local;SSL Mode=Disable

# CORS (origen del frontend)
CORS_ORIGIN=http://localhost:5173

# SMTP (correos transaccionales)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=FLIT Tramites

# Verifik (consultas RUNT — opcional en DEV)
VERIFIK_BASE_URL=https://api.verifik.co
VERIFIK_API_TOKEN=
VERIFIK_AUTH_SCHEME=Bearer
VERIFIK_TIMEOUT_SECONDS=30

# Puertos Docker (producción / VPS)
COMPOSE_PROJECT_NAME=abrahamc-dev
FRONTEND_PORT=40105
GATEWAY_PORT=40205
CORE_API_PORT=40305
