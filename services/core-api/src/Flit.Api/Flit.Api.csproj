<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Flit.Api</RootNamespace>
    <UserSecretsId>tramites-api-dev</UserSecretsId>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flit.SharedKernel\Flit.SharedKernel.csproj" />
    <ProjectReference Include="..\Flit.SharedKernel.Pdf\Flit.SharedKernel.Pdf.csproj" />
    <ProjectReference Include="..\Flit.Modules.Identity\Flit.Modules.Identity.csproj" />
    <ProjectReference Include="..\Flit.Modules.Users\Flit.Modules.Users.csproj" />
    <ProjectReference Include="..\Flit.Modules.Auth\Flit.Modules.Auth.csproj" />
    <ProjectReference Include="..\Flit.Modules.Rbac\Flit.Modules.Rbac.csproj" />
    <ProjectReference Include="..\Flit.Modules.IdentityVerification\Flit.Modules.IdentityVerification.csproj" />
    <ProjectReference Include="..\Flit.Modules.ProceduresConfig\Flit.Modules.ProceduresConfig.csproj" />
    <ProjectReference Include="..\Flit.Modules.Procedures\Flit.Modules.Procedures.csproj" />
    <ProjectReference Include="..\Flit.Modules.Integrations\Flit.Modules.Integrations.csproj" />
    <ProjectReference Include="..\Flit.Modules.Companies\Flit.Modules.Companies.csproj" />
    <ProjectReference Include="..\Flit.Infrastructure\Flit.Infrastructure.csproj" />
    <ProjectReference Include="..\Flit.Modules.Notifications\Flit.Modules.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

</Project>
