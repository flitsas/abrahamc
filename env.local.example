# Copia este archivo a `env.local` en la raíz del monorepo para desarrollo local.
# Tiene prioridad sobre `env` (VPS/producción). No se commitea (ver .gitignore).
#
# Requisito: Postgres en Docker → docker compose -f infra/docker-compose.yml up postgres -d

# PostgreSQL (.NET connection string)
CONNECTION_STRING_CORE=Host=localhost;Port=5433;Database=flit_dev;Username=flit;Password=flit_local;SSL Mode=Disable

# CORS (origen del frontend Vite)
CORS_ORIGIN=http://localhost:5173

# SMTP (opcional en local)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=FLIT Tramites

# Verifik (opcional en DEV)
VERIFIK_BASE_URL=https://api.verifik.co
VERIFIK_API_TOKEN=
VERIFIK_AUTH_SCHEME=Bearer
VERIFIK_TIMEOUT_SECONDS=30
